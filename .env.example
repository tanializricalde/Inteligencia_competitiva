APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
APP_BASE_URL=http://localhost:8000
APP_TIME_ZONE=America/Lima
DATABASE_PATH=data/market-watch.sqlite3
PIPELINE_ARTIFACT_ROOT=data/pipeline
MEDIA_ROOT=media
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=noreply@example.test
SCRAPER_USER_AGENT=MarketWatch/0.1 (+mailto:ops@example.test)
SCRAPER_MAX_RESPONSE_BYTES=5000000
SCRAPER_EVIDENCE_DIR=evidence
SCRAPER_ALLOW_PRIVATE_HOSTS=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

