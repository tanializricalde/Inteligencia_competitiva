APP_ENV=production
SECRET_KEY=CHANGE_ME_WITH_AT_LEAST_50_RANDOM_CHARACTERS
DEBUG=false
ALLOWED_HOSTS=market-watch.example.com
CSRF_TRUSTED_ORIGINS=https://market-watch.example.com
APP_BASE_URL=https://market-watch.example.com
APP_TIME_ZONE=America/Lima
DATABASE_PATH=/app/data/market-watch.sqlite3
PIPELINE_ARTIFACT_ROOT=/app/data/pipeline
MEDIA_ROOT=/app/media
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME
EMAIL_HOST_PASSWORD=CHANGE_ME
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@example.com
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/121.0.0.0 Safari/537.36
SCRAPER_MAX_RESPONSE_BYTES=5000000
SCRAPER_EVIDENCE_DIR=/app/evidence
SCRAPER_ALLOW_PRIVATE_HOSTS=false
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
WEB_PORT=8000

