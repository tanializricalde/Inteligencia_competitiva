{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/market-watch/feature-equivalence.schema.json",
  "title": "Market Watch feature equivalence rules",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "input",
    "behavior",
    "columns",
    "derived_columns",
    "rule_sets",
    "competitors"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "input": {"$ref": "#/$defs/input"},
    "behavior": {"$ref": "#/$defs/behavior"},
    "columns": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"$ref": "#/$defs/column"}
    },
    "derived_columns": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"$ref": "#/$defs/derived"}
    },
    "rule_sets": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {
        "type": "array",
        "items": {"$ref": "#/$defs/rule"}
      }
    },
    "competitors": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"$ref": "#/$defs/competitor"}
    }
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "names": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/name"}
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_by",
        "competitor_field",
        "text_field",
        "normalized_text_field",
        "included_field",
        "deduplicate_by"
      ],
      "properties": {
        "group_by": {"$ref": "#/$defs/names", "minItems": 1},
        "competitor_field": {"$ref": "#/$defs/name"},
        "text_field": {"$ref": "#/$defs/name"},
        "normalized_text_field": {"$ref": "#/$defs/name"},
        "included_field": {"$ref": "#/$defs/name"},
        "deduplicate_by": {"$ref": "#/$defs/names", "minItems": 1}
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknown_competitor",
        "multiple_matching_rules",
        "invalid_capture",
        "unmatched"
      ],
      "properties": {
        "unknown_competitor": {"enum": ["fallback", "error"]},
        "multiple_matching_rules": {"enum": ["error", "first"]},
        "invalid_capture": {"enum": ["error", "report"]},
        "unmatched": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "column_from", "value_from", "reducer", "default", "prefix"],
          "properties": {
            "mode": {"enum": ["dynamic_boolean", "ignore", "error"]},
            "column_from": {"$ref": "#/$defs/name"},
            "value_from": {"$ref": "#/$defs/name"},
            "reducer": {"enum": ["first", "last", "any", "all", "error"]},
            "default": {"type": ["boolean", "null"]},
            "prefix": {"type": "string"}
          }
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "default", "reducer"],
      "properties": {
        "type": {"enum": ["boolean", "integer", "decimal", "string", "string_list"]},
        "default": {},
        "reducer": {"enum": ["sum", "max", "min", "first", "last", "any", "all", "join_unique", "error"]},
        "tags": {"$ref": "#/$defs/names"},
        "label": {"type": "string", "minLength": 1}
      }
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "operation"],
      "properties": {
        "type": {"enum": ["boolean", "integer", "decimal", "string", "string_list"]},
        "operation": {"enum": ["sum_columns", "count_true", "join_labels"]},
        "inputs": {"$ref": "#/$defs/names"},
        "select": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag"],
          "properties": {"tag": {"$ref": "#/$defs/name"}}
        },
        "null_policy": {"enum": ["null_if_all_null"]},
        "separator": {"type": "string"},
        "distinct": {"type": "boolean"},
        "default": {}
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "operator", "value"],
          "properties": {
            "field": {"$ref": "#/$defs/name"},
            "operator": {"const": "equals"},
            "value": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "operator", "pattern"],
          "properties": {
            "field": {"$ref": "#/$defs/name"},
            "operator": {"const": "regex"},
            "pattern": {"type": "string", "minLength": 1},
            "flags": {
              "type": "array",
              "uniqueItems": true,
              "items": {"enum": ["IGNORECASE", "MULTILINE"]}
            }
          }
        }
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column", "value"],
      "properties": {
        "column": {"$ref": "#/$defs/name"},
        "value": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["capture"],
              "properties": {"capture": {"$ref": "#/$defs/name"}}
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["literal"],
              "properties": {"literal": {}}
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["field"],
              "properties": {"field": {"$ref": "#/$defs/name"}}
            }
          ]
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "priority", "when", "outputs", "consume"],
      "properties": {
        "id": {"$ref": "#/$defs/name"},
        "priority": {"type": "integer"},
        "when": {"$ref": "#/$defs/condition"},
        "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/output"}},
        "consume": {"type": "boolean"}
      }
    },
    "competitor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_sets"],
      "properties": {
        "rule_sets": {"$ref": "#/$defs/names"},
        "column_defaults": {"type": "object"}
      }
    }
  }
}
